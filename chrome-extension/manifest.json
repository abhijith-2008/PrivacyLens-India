
{
  "manifest_version": 3,
  "name": "PrivacyLens India",
  "version": "1.0.0",
  "description": "Understand website privacy policies with AI-powered analysis and an informational DPDP checklist.",

  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],

  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1:8000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "PrivacyLens India"
  },

  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
